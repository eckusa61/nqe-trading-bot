# NQE Trading Bot - Environment Variables
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun

# Database
MONGO_URL=mongodb://localhost:27017
DB_NAME=trading_bot

# AI APIs (kendi anahtarlarınızı girin)
OPENAI_API_KEY=sk-proj-YOUR_KEY_HERE
CLAUDE_API_KEY=sk-ant-YOUR_KEY_HERE

# Telegram Bots (kendi bot tokenlarınızı girin)
TELEGRAM_HABER_TOKEN=YOUR_TOKEN_HERE
TELEGRAM_HABER_CHAT_ID=YOUR_CHAT_ID_HERE

TELEGRAM_SINYAL_TOKEN=YOUR_TOKEN_HERE
TELEGRAM_SINYAL_CHAT_ID=YOUR_CHAT_ID_HERE

TELEGRAM_ANALIZ_TOKEN=YOUR_TOKEN_HERE
TELEGRAM_ANALIZ_CHAT_ID=YOUR_CHAT_ID_HERE

TELEGRAM_OPTIMIZASYON_TOKEN=YOUR_TOKEN_HERE
TELEGRAM_OPTIMIZASYON_CHAT_ID=YOUR_CHAT_ID_HERE

# Reddit API (opsiyonel)
REDDIT_CLIENT_ID=YOUR_CLIENT_ID
REDDIT_CLIENT_SECRET=YOUR_SECRET

# News API (opsiyonel)
NEWSAPI_KEY=YOUR_KEY
ALPHAVANTAGE_KEY=YOUR_KEY
